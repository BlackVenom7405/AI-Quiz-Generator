# ==========================================
# QuizGenius AI - Git Ignore
# ==========================================

# Environment variables & secrets
.env
.env.*
backend/.env
backend/.env.*
!.env.example
!backend/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
env/
ENV/
.venv/
backend/venv/
backend/env/
backend/.venv/

# Node & Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & SQLite files
*.sqlite
*.sqlite3
*.db
backend/*.db
quiz_genius.db
backend/quiz_genius.db

# Uploaded documents
backend/uploads/*
!backend/uploads/.gitkeep

# IDEs & Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
